rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthorizedDoctorForPatient(patientId) {
      let linkPath = /databases/$(database)/documents/links/$(patientId + "_" + request.auth.uid);
      return isSignedIn() && exists(linkPath) && get(linkPath).data.status == 'authorized';
    }

    // Accounts collection (least privilege: direct get only, no bulk enumeration)
    match /accounts/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId);
      allow update: if isValidId(userId) && isOwner(userId);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // PatientData collection (requires effective authorization, pending links denied)
    match /patientData/{patientId} {
      allow get: if isValidId(patientId) && (
        isOwner(patientId) || 
        isAuthorizedDoctorForPatient(patientId)
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        isAuthorizedDoctorForPatient(resource.data.patientId)
      );
      allow create: if isValidId(patientId) && isOwner(patientId);
      allow update: if isValidId(patientId) && isOwner(patientId);
      allow delete: if isValidId(patientId) && isOwner(patientId);
    }

    // Links collection (participant immutability, only patient can authorize)
    match /links/{linkId} {
      allow get: if isValidId(linkId) && isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      );
      allow create: if isValidId(linkId) && isSignedIn() && (
        request.resource.data.patientId == request.auth.uid || 
        request.resource.data.doctorId == request.auth.uid
      ) && request.resource.data.status in ['pending', 'authorized'];
      allow update: if isValidId(linkId) && isSignedIn() && (
        // Must be participant
        (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid) &&
        // Participants are immutable
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.doctorId == resource.data.doctorId &&
        // Only patient can authorize a pending request (doctor cannot self-authorize)
        (request.resource.data.status != 'authorized' || request.auth.uid == resource.data.patientId)
      );
      allow delete: if isValidId(linkId) && isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid
      );
      allow create: if isValidId(notificationId) && isSignedIn() && (
        request.resource.data.fromUserId == request.auth.uid
      );
      allow update: if isValidId(notificationId) && isSignedIn() && (
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid
      );
      allow delete: if isValidId(notificationId) && isSignedIn() && (
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid
      );
    }

    // Test heartbeat connection
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
