# OAuth client ID for the Google Drive photo integration (Web application).
# Restrict its authorized origins to the production app and local development URLs.
VITE_GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional science routes use public APIs; Google Drive storage is charged against each user's own Drive quota.
# All endpoints work out-of-the-box without keys.
# Optional free keys unlock higher throughput limits:
# FDA_API_KEY: Free from https://open.fda.gov/apis/authentication/ (unlocks 120,000 req/day)
# NCBI_API_KEY: Free from https://www.ncbi.nlm.nih.gov/account/settings/ (unlocks 10 req/s)
# FDA_API_KEY=
# NCBI_API_KEY=
# NCBI_CONTACT_EMAIL=you@example.com

