{
  "diagram_spec": {
    "meta": {
      "spec_version": "1.0.0",
      "name": "Atlas anatômico clínico Nathan",
      "usage_context": "medical_app",
      "asset_family": "anatomy_nathan_v2"
    },
    "canvas": {
      "background": "transparent",
      "layout": "isolated_single_asset",
      "resolution": "high",
      "preferred_export": [
        "PNG_RGBA",
        "SVG_container"
      ]
    },
    "semantics": {
      "type": "anatomical_body_map",
      "audience": "rheumatology",
      "orientation": "orthographic",
      "patient_laterality": "locked"
    },
    "nodes": [
      {
        "id": "body_front",
        "role": "anatomy",
        "view": "anterior",
        "must_show": [
          "clavicles",
          "shoulders",
          "elbows",
          "wrists",
          "hips",
          "knees",
          "ankles",
          "hands",
          "feet"
        ]
      },
      {
        "id": "body_back",
        "role": "anatomy",
        "view": "posterior",
        "must_show": [
          "scapulae",
          "spine_regions",
          "gluteal_region",
          "posterior_elbows",
          "knees",
          "achilles_region"
        ]
      },
      {
        "id": "right_hand",
        "role": "detail",
        "view": "dorsal",
        "digits": 5
      },
      {
        "id": "left_hand",
        "role": "detail",
        "view": "dorsal",
        "digits": 5
      },
      {
        "id": "right_foot",
        "role": "detail",
        "view": "dorsal",
        "toes": 5
      },
      {
        "id": "left_foot",
        "role": "detail",
        "view": "dorsal",
        "toes": 5
      }
    ],
    "style": {
      "body_fill": "#E9EDF1",
      "outer_contour": "#8997A5",
      "detail_contour": "#B6C4D1",
      "sex_characteristics": "none",
      "skin_tone": "unassigned",
      "medical_detail": "medium_high"
    },
    "constraints": {
      "lock_anatomic_landmarks": true,
      "lock_body_geometry_between_views": true,
      "allow_marker_overlay": false,
      "allow_gender_cues": false,
      "allow_skin_tone_coding": false,
      "allow_labels": false,
      "require_transparent_background": true,
      "require_clinician_review": true
    }
  }
}